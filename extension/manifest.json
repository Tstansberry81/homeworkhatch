{
  "manifest_version": 3,
  "name": "Homework Hatch",
  "version": "1.3.0",
  "description": "Syncs your own Canvas classes, deadlines, grades and files to Homework Hatch using your normal Canvas login.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Homework Hatch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "downloads",
    "activeTab",
    "offscreen"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
