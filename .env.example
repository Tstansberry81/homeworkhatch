# Copy to .env for local development. Every setting is optional locally.

# Required in production.
SECRET_KEY=change-me
# Postgres in production (Render sets this). Defaults to instance/homeworkhatch.db (SQLite).
# DATABASE_URL=postgresql://user:pass@host:5432/homeworkhatch
# The site's public address (used in Stripe return links and the extension setup page).
# PUBLIC_URL=https://homeworkhatch.example.com

# AI (tutor, summaries, generated flashcards/quizzes). Without it, AI features are hidden.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5

# File storage for synced Canvas files: "local" (default) or "s3" (AWS S3, Cloudflare R2, MinIO).
# STORAGE_BACKEND=s3
# S3_BUCKET=homeworkhatch-files
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Billing (optional). Without these, everyone is on the free plan.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_NORMAL=price_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_PRO=price_...

# College calculator school search (free key: https://api.data.gov/signup/).
# COLLEGE_SCORECARD_API_KEY=...

# REQUIRE_APPROVAL=1          # new accounts wait for an admin
# FEATURE_SIMULATIONS=1       # 18+ Probability Lab
