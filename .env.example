# Copy to .env for local development. Everything is optional locally: with nothing set, the
# app uses SQLite (instance/homeworkhatch.db) and stores files on disk (instance/storage).
# Never commit .env — it's in .gitignore.

# --- Required in production (Render) ---
SECRET_KEY=change-me
# Supabase -> Connect -> Session pooler (IPv4). Render and GitHub Actions can't reach the
# IPv6-only direct host (db.<ref>.supabase.co). sslmode=require is added automatically.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Optional pool tuning: keep workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW) under Supabase's pooler "Pool Size".
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2

# --- File storage ---
# local (default, development only) | supabase | s3
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_BUCKET=canvas-files
# SUPABASE_S3_REGION=us-east-1
# SUPABASE_S3_ACCESS_KEY_ID=...
# SUPABASE_S3_SECRET_ACCESS_KEY=...
# Supabase Free caps files at 50 MB (the default limit for the supabase backend).
# MAX_FILE_MB=50
# Other S3-compatible storage instead (AWS S3, Cloudflare R2):
# STORAGE_BACKEND=s3
# S3_BUCKET=... S3_ENDPOINT_URL=... S3_REGION=... S3_ACCESS_KEY_ID=... S3_SECRET_ACCESS_KEY=...

# --- The site's public address (Stripe return links, extension setup page) ---
# PUBLIC_URL=https://homeworkhatch.onrender.com

# --- AI (tutor, summaries, generated study sets); hidden without a key ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Google Calendar + Google Drive through Composio (https://composio.dev) ---
# COMPOSIO_API_KEY=...
# AI_MODEL=claude-opus-5-5

# --- Billing (optional; without it everyone is on the free plan) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_NORMAL=price_...
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_PRO=price_...


# ADMIN_EMAIL=you@example.com   # this account becomes admin (production never auto-promotes)
# REQUIRE_APPROVAL=1       # new accounts wait for an admin
# FEATURE_SIMULATIONS=1    # 18+ Probability Lab
